@page
@model FHP.Web.Pages.ViewUserPasswordModel
<div class="mx-auto max-w-2xl">
    <div class="mb-6 flex items-center gap-3">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-600 text-white shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 00-1.06 1.06l18.5 18.5a.75.75 0 101.06-1.06l-1.322-1.323a13.19 13.19 0 003.28-4.058.75.75 0 000-.681C21.751 9.75 17.404 6.75 12 6.75c-1.51 0-2.933.235-4.222.662l-1.55-1.55A13.42 13.42 0 0112 5.25c5.86 0 10.673 3.65 12.625 8.632a.75.75 0 010 .513 12.994 12.994 0 01-3.837 5.19l-1.038-1.038a11.42 11.42 0 003.32-4.417 11.428 11.428 0 00-15.928-5.928l-1.86-1.86zM12 15a3 3 0 001.658-5.502l-4.16-4.16A3 3 0 0012 15z" clip-rule="evenodd" /></svg>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-900">View User Password</h1>
            <p class="text-sm text-slate-500">Passwords are hashed and can never be displayed — this confirms an account exists.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-4 flex items-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0 text-rose-500"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12 15a.75.75 0 100 1.5.75.75 0 000-1.5zm0-8.25a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5a.75.75 0 01.75-.75z" clip-rule="evenodd" /></svg>
            @Model.ErrorMessage
        </div>
    }

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <form method="post" asp-page="/ViewUserPassword" class="space-y-4">
            <div>
                <label asp-for="UserId" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">User ID</label>
                <input asp-for="UserId" placeholder="Enter a User ID" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
            </div>

            <div>
                <label asp-for="SecurityPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Security Password <span class="text-orange-500">*</span></label>
                <input asp-for="SecurityPassword" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
                <span asp-validation-for="SecurityPassword" class="mt-1 block text-xs text-rose-600"></span>
                <p class="mt-1 text-xs text-slate-400">Enter your own security password to confirm this lookup.</p>
            </div>

            <div class="flex justify-end border-t border-slate-100 pt-5">
                <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" /></svg>
                    Search
                </button>
            </div>
        </form>
    </div>

    <div class="mt-6">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Result</h2>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Password</div>
            @if (Model.HasSearched)
            {
                <div class="mt-2 flex items-start gap-2 text-sm text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-slate-400"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" /></svg>
                    @Model.ResultMessage
                </div>
            }
            else
            {
                <p class="mt-2 text-sm text-slate-400">Search for a User ID to see the result here.</p>
            }
        </div>
    </div>
</div>
