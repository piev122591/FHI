@page
@model FHP.Web.Pages.UserSetupFormModel
<div class="mx-auto max-w-3xl">
    <div class="mb-6 flex items-center gap-3">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-600 text-white shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" /></svg>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-900">@Model.Heading</h1>
            <p class="text-sm text-slate-500">
                @if (Model.IsViewMode)
                {
                    <text>Viewing user details (read-only).</text>
                }
                else if (Model.IsAddMode)
                {
                    <text>Create a new login user and assign a group.</text>
                }
                else
                {
                    <text>Update this user's details, group, or status.</text>
                }
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-4 flex items-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0 text-rose-500"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12 15a.75.75 0 100 1.5.75.75 0 000-1.5zm0-8.25a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5a.75.75 0 01.75-.75z" clip-rule="evenodd" /></svg>
            @Model.ErrorMessage
        </div>
    }

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <form method="post" asp-page="/UserSetupForm">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Mode" />

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="UserId" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">User ID</label>
                    <input asp-for="UserId" disabled="@Model.IsViewMode" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100 disabled:border-slate-200 disabled:bg-slate-50 disabled:text-slate-500" />
                    <span asp-validation-for="UserId" class="mt-1 block text-xs text-rose-600"></span>
                </div>

                <div>
                    <label asp-for="StaffName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Staff Name</label>
                    <input asp-for="StaffName" disabled="@Model.IsViewMode" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100 disabled:border-slate-200 disabled:bg-slate-50 disabled:text-slate-500" />
                    <span asp-validation-for="StaffName" class="mt-1 block text-xs text-rose-600"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Email" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Email</label>
                    <input asp-for="Email" disabled="@Model.IsViewMode" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100 disabled:border-slate-200 disabled:bg-slate-50 disabled:text-slate-500" />
                    <span asp-validation-for="Email" class="mt-1 block text-xs text-rose-600"></span>
                </div>

                @if (!Model.IsViewMode)
                {
                    <div>
                        <label asp-for="Password" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Password</label>
                        <input asp-for="Password" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
                        @if (!Model.IsAddMode)
                        {
                            <p class="mt-1 text-xs text-slate-400">Leave blank to keep the current password.</p>
                        }
                        <span asp-validation-for="Password" class="mt-1 block text-xs text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
                        <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-rose-600"></span>
                    </div>
                }

                <div>
                    <label asp-for="UserGroup" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">User Group</label>
                    <div class="relative">
                        <select asp-for="UserGroup" asp-items="Model.UserGroupOptions" disabled="@Model.IsViewMode" class="w-full appearance-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 pr-9 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100 disabled:border-slate-200 disabled:bg-slate-50 disabled:text-slate-500"></select>
                        @if (!Model.IsViewMode)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                        }
                    </div>
                </div>

                <div>
                    <label asp-for="Status" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Status</label>
                    <div class="relative">
                        <select asp-for="Status" disabled="@Model.IsViewMode" class="w-full appearance-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 pr-9 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100 disabled:border-slate-200 disabled:bg-slate-50 disabled:text-slate-500">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        @if (!Model.IsViewMode)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-6 flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">
                <a asp-page="/UserSetup" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
                    Back to User Setup
                </a>
                @if (!Model.IsViewMode)
                {
                    <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5" /></svg>
                        Save
                    </button>
                }
            </div>
        </form>
    </div>
</div>
