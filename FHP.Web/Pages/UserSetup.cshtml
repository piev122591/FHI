@page
@model FHP.Web.Pages.UserSetupModel
@{
    Func<string, string> initials = name =>
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        var chars = "";
        foreach (var part in parts)
        {
            if (chars.Length >= 2) break;
            chars += char.ToUpperInvariant(part[0]);
        }
        return chars.Length == 0 ? "?" : chars;
    };
    Func<string, string> statusPillClass = status =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase)
            ? "inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20"
            : "inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-2.5 py-1 text-xs font-medium text-rose-700 ring-1 ring-inset ring-rose-600/20";
    Func<string, string> statusDotClass = status =>
        string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase)
            ? "h-1.5 w-1.5 rounded-full bg-emerald-500"
            : "h-1.5 w-1.5 rounded-full bg-rose-500";
}
<div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center gap-3">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-600 text-white shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" /></svg>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-900">User Setup</h1>
            <p class="text-sm text-slate-500">Search, create, and manage login users.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="mb-4 flex items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0 text-emerald-500"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" /></svg>
            @Model.Message
        </div>
    }

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <form method="get" asp-page="/UserSetup">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div>
                    <label asp-for="UserId" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">User ID</label>
                    <input asp-for="UserId" placeholder="Search by User ID" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
                </div>

                <div>
                    <label asp-for="StaffName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Staff Name</label>
                    <input asp-for="StaffName" placeholder="Search by staff name" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
                </div>

                <div>
                    <label asp-for="UserGroup" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">User Group <span class="text-orange-500">*</span></label>
                    <div class="relative">
                        <select asp-for="UserGroup" asp-items="Model.UserGroupOptions" class="w-full appearance-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 pr-9 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100">
                            <option value="">-- All User Group --</option>
                        </select>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                    </div>
                </div>

                <div>
                    <label asp-for="Status" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Status <span class="text-orange-500">*</span></label>
                    <div class="relative">
                        <select asp-for="Status" class="w-full appearance-none rounded-lg border border-slate-300 bg-white px-3 py-2.5 pr-9 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100">
                            <option value="@FHP.Core.Models.UserStatuses.Active">Active</option>
                            <option value="@FHP.Core.Models.UserStatuses.Inactive">Inactive</option>
                        </select>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                    </div>
                </div>
            </div>

            <div class="mt-5 flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-end">
                <a asp-page="/UserSetupForm" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-700">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    Add New
                </a>
                <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" /></svg>
                    Search
                </button>
            </div>
        </form>
    </div>

    <div class="mt-6">
        <div class="mb-3 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Result</h2>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">@Model.Results.Count record@(Model.Results.Count == 1 ? "" : "s")</span>
        </div>

        @if (Model.Results.Count == 0)
        {
            <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-10 w-10 text-slate-300"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                <p class="mt-3 text-sm font-medium text-slate-600">No users found</p>
                <p class="mt-1 text-xs text-slate-400">Try adjusting your search filters, or add a new user.</p>
            </div>
        }
        else
        {
            <!-- Desktop / tablet table -->
            <div class="hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm md:block">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-100 text-sm">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">User</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">User Group</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Status</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">Last Updated</th>
                                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var user in Model.Results)
                            {
                                <tr class="transition hover:bg-slate-50">
                                    <td class="px-4 py-3">
                                        <div class="flex items-center gap-3">
                                            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
                                                @initials(user.FullName)
                                            </div>
                                            <div class="min-w-0">
                                                <div class="truncate font-medium text-slate-800">@user.FullName</div>
                                                <div class="truncate text-xs text-slate-400">@@@user.Username</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">@user.UserGroup</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="@statusPillClass(user.Status)">
                                            <span class="@statusDotClass(user.Status)"></span>
                                            @user.Status
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="text-slate-600">@user.LastUpdateBy</div>
                                        <div class="text-xs text-slate-400">@user.LastUpdateDate.ToString("yyyy-MM-dd HH:mm:ss")</div>
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <a asp-page="/UserSetupForm" asp-route-id="@user.Id" asp-route-mode="view" class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-teal-700 transition hover:bg-teal-50">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Mobile cards -->
            <div class="grid grid-cols-1 gap-3 md:hidden">
                @foreach (var user in Model.Results)
                {
                    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex min-w-0 items-center gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">
                                    @initials(user.FullName)
                                </div>
                                <div class="min-w-0">
                                    <div class="truncate font-medium text-slate-800">@user.FullName</div>
                                    <div class="truncate text-xs text-slate-400">@@@user.Username</div>
                                </div>
                            </div>
                            <span class="@statusPillClass(user.Status)">
                                <span class="@statusDotClass(user.Status)"></span>
                                @user.Status
                            </span>
                        </div>

                        <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                            <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600">@user.UserGroup</span>
                            <span>Updated by <span class="font-medium text-slate-600">@user.LastUpdateBy</span></span>
                            <span>&middot;</span>
                            <span>@user.LastUpdateDate.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>

                        <div class="mt-3 border-t border-slate-100 pt-3">
                            <a asp-page="/UserSetupForm" asp-route-id="@user.Id" asp-route-mode="view" class="inline-flex items-center gap-1.5 text-sm font-semibold text-teal-700">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                View details
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
