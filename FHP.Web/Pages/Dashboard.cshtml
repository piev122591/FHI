        </div>
        <div class="grid grid-cols-2 border-b border-slate-100 bg-slate-50/60 px-5 py-2 text-xs font-semibold uppercase tracking-wide text-slate-400">
            <span>Date</span>
            <span>Title</span>
        </div>
        <div class="flex flex-1 flex-col items-center justify-center gap-2 py-16 text-center">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-teal-50 text-teal-400">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c1.83.150 3.579.437 5.213.836a11.968 11.968 0 002.94 3.606.75.75 0 001.222-.848 32.16 32.16 0 01-1.157-4.593m-8.218-9.181A11.965 11.965 0 0112.06 4.06a1.001 1.001 0 011.518.9 32.06 32.06 0 01-.157 5.837m-9.181-8.218a11.965 11.965 0 00-2.94 3.606.75.75 0 00.848 1.222c.887.155 1.762.35 2.622.586" /></svg>
