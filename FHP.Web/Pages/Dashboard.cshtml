@page
@model FHP.Web.Pages.DashboardModel

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-xl font-bold tracking-tight text-slate-900">Overview</h1>
        <p class="mt-0.5 text-sm text-slate-500">Here's what's happening across your network today.</p>
    </div>
    <div class="relative">
        <select class="w-full appearance-none rounded-full border border-slate-200 bg-white py-2 pl-4 pr-9 text-sm font-medium text-slate-700 shadow-sm focus:border-teal-300 focus:outline-none focus:ring-2 focus:ring-teal-100 sm:w-48">
            <option>Philippines</option>
            <option>Indonesia</option>
            <option>Malaysia</option>
        </select>
        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
        </span>
    </div>
</div>

