        ["blue"] = ("bg-blue-50 text-blue-600", "bg-blue-200", "hover:shadow-blue-100", "border-l-blue-400"),
        ["amber"] = ("bg-amber-50 text-amber-600", "bg-amber-200", "hover:shadow-amber-100", "border-l-amber-400"),
        ["pink"] = ("bg-pink-50 text-pink-600", "bg-pink-200", "hover:shadow-pink-100", "border-l-pink-400"),
        ["orange"] = ("bg-orange-50 text-orange-600", "bg-orange-200", "hover:shadow-orange-100", "border-l-orange-400"),
        ["sky"] = ("bg-sky-50 text-sky-600", "bg-sky-200", "hover:shadow-sky-100", "border-l-sky-400"),
        ["teal"] = ("bg-teal-50 text-teal-600", "bg-teal-200", "hover:shadow-teal-100", "border-l-teal-400"),
    };

