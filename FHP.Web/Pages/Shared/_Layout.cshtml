                        </a>
                        <a href="#" class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-slate-400 transition hover:text-white">
                            <span class="h-1 w-1 shrink-0 rounded-full bg-slate-500"></span> Product SubCategory Setup
                        </a>
                        <a href="#" class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-slate-400 transition hover:text-white">
                            <span class="h-1 w-1 shrink-0 rounded-full bg-slate-500"></span> Bank Branch Setup
                        </a>
                        <a href="#" class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-slate-400 transition hover:text-white">
                            <span class="h-1 w-1 shrink-0 rounded-full bg-slate-500"></span> Product Setup
                        </a>
                        <a href="#" class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-slate-400 transition hover:text-white">
                            <span class="h-1 w-1 shrink-0 rounded-full bg-slate-500"></span> Product Package Setup
                        </a>
                        <a href="#" class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-slate-400 transition hover:text-white">
                            <span class="h-1 w-1 shrink-0 rounded-full bg-slate-500"></span> Announcement Popout Listing
                        </a>
                        <a href="#" class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-slate-400 transition hover:text-white">
                            <span class="h-1 w-1 shrink-0 rounded-full bg-slate-500"></span> Announcement Listing
                        </a>
                        <a href="#" class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-slate-400 transition hover:text-white">
