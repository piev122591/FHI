@using System.Linq
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FHP Admin</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-slate-50 text-slate-800">
    <div id="sidebarOverlay" class="fixed inset-0 z-20 hidden bg-slate-900/50 backdrop-blur-sm md:hidden"></div>

    @{
        var currentPath = Context.Request.Path.Value ?? "";
        Func<string, bool> isCurrent = path => currentPath.Equals(path, StringComparison.OrdinalIgnoreCase);
        Func<string, string> navClass = path =>
            isCurrent(path)
                ? "group relative flex items-center gap-3 rounded-lg bg-teal-400/10 px-3 py-2 text-sm font-medium text-white"
                : "group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-slate-400 transition hover:bg-white/5 hover:text-white";
        Func<string, string> navIndicator = path =>
            isCurrent(path)
                ? "absolute left-0 top-1/2 h-5 w-0.5 -translate-y-1/2 rounded-r bg-teal-400"
                : "absolute left-0 top-1/2 h-5 w-0.5 -translate-y-1/2 rounded-r bg-transparent";

        // Section = a collapsible group (Login User, Member Management, ...). It's
        // "active" when the current page is one of its child pages, which drives the
        // parent toggle highlight, auto-expanding the submenu, and the chevron rotation.
        Func<string[], bool> sectionActive = paths => paths.Any(isCurrent);
        Func<bool, string> sectionToggleClass = active =>
            active
                ? "group relative flex items-center gap-3 rounded-lg bg-teal-400/10 px-3 py-2 text-sm font-medium text-white w-full"
                : "group relative flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-slate-400 transition hover:bg-white/5 hover:text-white w-full";
        Func<bool, string> sectionIndicatorClass = active =>
            active
                ? "absolute left-0 top-1/2 h-5 w-0.5 -translate-y-1/2 rounded-r bg-teal-400"
                : "absolute left-0 top-1/2 h-5 w-0.5 -translate-y-1/2 rounded-r bg-transparent";
        Func<bool, string> sectionChevronClass = active =>
            active
                ? "h-4 w-4 shrink-0 transition-transform rotate-180"
                : "h-4 w-4 shrink-0 transition-transform";
        Func<bool, string> sectionSubmenuClass = active =>
            active
                ? "mt-1 flex flex-col gap-1 py-1"
                : "mt-1 hidden flex-col gap-1 py-1";

        // Submenu (child) link — highlights the specific item that matches the page.
        Func<string, string> subNavClass = path =>
            isCurrent(path)
                ? "flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-white transition"
                : "flex items-center gap-2.5 rounded-lg px-3 py-1.5 pl-9 text-sm font-medium text-slate-400 transition hover:text-white";
        Func<string, string> subNavDot = path =>
            isCurrent(path)
                ? "h-1 w-1 shrink-0 rounded-full bg-teal-400"
                : "h-1 w-1 shrink-0 rounded-full bg-slate-500";

        bool loginUserActive = sectionActive(new[] { "/UserSetup", "/UserSetupForm", "/UserGroup", "/UserGroupForm", "/ChangeLoginPassword", "/ChangeSecurityPassword", "/ResetUserLoginPassword", "/ResetUserSecurityPassword", "/ViewUserPassword", "/DashboardSetup", "/DashboardSetupForm" });
        bool memberManagementActive = sectionActive(new[] { "/Users", "/UserForm" });

        string fullName = User.FindFirst("FullName")?.Value ?? "";
        string initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => char.ToUpperInvariant(w[0]))).PadRight(1, '?');
        if (initials.Length > 2) initials = initials.Substring(0, 2);
    }

    <div class="flex min-h-screen">
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-30 flex w-64 -translate-x-full transform flex-col overflow-y-auto bg-gradient-to-b from-slate-900 to-slate-950 text-slate-100 transition-transform duration-200 ease-in-out md:static md:translate-x-0">
            <div class="flex items-center gap-3 border-b border-white/10 p-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-teal-400 to-emerald-600 text-sm font-semibold text-white shadow-lg shadow-emerald-500/20">
                    @initials
                </div>
                <div class="min-w-0">
                    <div class="truncate text-sm font-semibold text-white">@fullName</div>
                    <div class="mt-0.5 flex items-center gap-1.5">
                        <span class="rounded-full bg-white/10 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-slate-300">@User.FindFirst(ClaimTypes.Role)?.Value</span>
                        <span class="flex items-center gap-1 text-[11px] text-emerald-400">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> Online
                        </span>
                    </div>
                </div>
            </div>

            <nav class="flex flex-1 flex-col gap-1 px-3 py-4">
                <a asp-page="/Dashboard" class="@navClass("/Dashboard")">
                    <span class="@navIndicator("/Dashboard")"></span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0"><path d="M11.47 3.841a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.061l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.689z" /><path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" /></svg>
                    Home
                </a>

                <div class="mt-4 px-3 pb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">Management</div>
                <div>
                    <button type="button" id="loginUserToggle" aria-expanded="@(loginUserActive ? "true" : "false")" aria-controls="loginUserSubmenu" class="@sectionToggleClass(loginUserActive)">
                        <span class="@sectionIndicatorClass(loginUserActive)"></span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0"><path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" /></svg>
                        <span class="flex-1 text-left">Login User</span>
                        <svg id="loginUserChevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="@sectionChevronClass(loginUserActive)"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                    </button>
                    <div id="loginUserSubmenu" class="@sectionSubmenuClass(loginUserActive)">
                        <a asp-page="/UserSetup" class="@subNavClass("/UserSetup")">
                            <span class="@subNavDot("/UserSetup")"></span> User Setup
                        </a>
                        <a asp-page="/UserGroup" class="@subNavClass("/UserGroup")">
                            <span class="@subNavDot("/UserGroup")"></span> User Group
                        </a>
                        <a asp-page="/ChangeLoginPassword" class="@subNavClass("/ChangeLoginPassword")">
                            <span class="@subNavDot("/ChangeLoginPassword")"></span> Change Login Password
                        </a>
                        <a asp-page="/ChangeSecurityPassword" class="@subNavClass("/ChangeSecurityPassword")">
                            <span class="@subNavDot("/ChangeSecurityPassword")"></span> Change Security Password
                        </a>
                        <a asp-page="/ResetUserLoginPassword" class="@subNavClass("/ResetUserLoginPassword")">
                            <span class="@subNavDot("/ResetUserLoginPassword")"></span> Reset User Login Password
                        </a>
                        <a asp-page="/ResetUserSecurityPassword" class="@subNavClass("/ResetUserSecurityPassword")">
                            <span class="@subNavDot("/ResetUserSecurityPassword")"></span> Reset User Security Password
                        </a>
                        <a asp-page="/ViewUserPassword" class="@subNavClass("/ViewUserPassword")">
