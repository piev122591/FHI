                <div>
                    <button type="button" id="redemptionToggle" aria-expanded="false" aria-controls="redemptionSubmenu" class="@navClass("/Redemption") w-full">
                        <span class="@navIndicator("/Redemption")"></span>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0"><path d="M9.375 3a1.875 1.875 0 000 3.75h1.875v4.5H3.375A1.875 1.875 0 011.5 9.375v-.75c0-1.036.84-1.875 1.875-1.875h3.193A3.375 3.375 0 019.375 3zM11.25 3.75V6h4.5V3.75a1.875 1.875 0 10-1.875 1.875H11.25zm-2.625 4.5V21H4.5a1.5 1.5 0 01-1.5-1.5V8.25h5.625zM12.75 8.25V21h5.25a1.5 1.5 0 001.5-1.5V8.25h-6.75z" /></svg>
