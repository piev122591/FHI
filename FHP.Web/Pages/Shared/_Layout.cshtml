                <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-teal-200/30 blur-3xl"></div>
                <div class="pointer-events-none absolute -left-24 top-1/3 h-80 w-80 rounded-full bg-emerald-100/40 blur-3xl"></div>

                <main class="relative z-10 p-4 sm:p-6">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
    <script src="~/js/site.js"></script>
</body>
</html>
