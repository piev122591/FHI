@page
@model FHP.Web.Pages.ChangeLoginPasswordModel
<div class="mx-auto max-w-xl">
    <div class="mb-6 flex items-center gap-3">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-emerald-600 text-white shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd" /></svg>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-900">Change Login Password</h1>
            <p class="text-sm text-slate-500">Update the password you use to sign in.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-4 flex items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0 text-emerald-500"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" /></svg>
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-4 flex items-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0 text-rose-500"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12 15a.75.75 0 100 1.5.75.75 0 000-1.5zm0-8.25a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5a.75.75 0 01.75-.75z" clip-rule="evenodd" /></svg>
            @Model.ErrorMessage
        </div>
    }

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <form method="post" asp-page="/ChangeLoginPassword" class="space-y-4">
            <div>
                <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">User ID</label>
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-600">@User.Identity?.Name</div>
            </div>

            <div>
                <label asp-for="CurrentPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Current Login Password <span class="text-orange-500">*</span></label>
                <input asp-for="CurrentPassword" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
                <span asp-validation-for="CurrentPassword" class="mt-1 block text-xs text-rose-600"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">New Login Password <span class="text-orange-500">*</span></label>
                <input asp-for="NewPassword" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
                <span asp-validation-for="NewPassword" class="mt-1 block text-xs text-rose-600"></span>
            </div>

            <div>
                <label asp-for="RetypePassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Retype Login Password <span class="text-orange-500">*</span></label>
                <input asp-for="RetypePassword" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 transition focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-100" />
                <span asp-validation-for="RetypePassword" class="mt-1 block text-xs text-rose-600"></span>
            </div>

            <div class="flex justify-end border-t border-slate-100 pt-5">
                <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5" /></svg>
                    Update
                </button>
            </div>
        </form>
    </div>
</div>
